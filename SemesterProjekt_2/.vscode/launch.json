{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run OpenCV",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/DisplayImage",
            "args": ["${workspaceFolder}/savedImage.jpg"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "externalConsole": true,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}
