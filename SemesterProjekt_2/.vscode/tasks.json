{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build OpenCV",
            "type": "shell",
            "command": "bash",
            "args": [
                "-c",
                "g++ -g -I/usr/include/opencv4 -o DisplayImage DisplayImage.cpp $(pkg-config --cflags --libs opencv4)"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        }
    ]
}
